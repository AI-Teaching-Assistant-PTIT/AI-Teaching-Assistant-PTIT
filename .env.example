# Postgres Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_secret_password
POSTGRES_DB=gitptit

# Gitea runtime database values
GITEA__database__HOST=postgres:5432
GITEA__database__USER=admin
GITEA__database__PASSWD=admin_secret_password
GITEA__database__NAME=gitptit
GITEA__database__SSL_MODE=disable

# Gitea bootstrap administrator (container tự tạo trong lần khởi động đầu)
GITEA_ADMIN_USERNAME=admin
GITEA_ADMIN_PASSWORD=change_this_to_a_strong_password
GITEA_ADMIN_EMAIL=admin@example.com

# Gitea bootstrap tuỳ chọn (bỏ trống để dùng mặc định trong gitptit/scripts/bootstrap.sh)
# SSO_AUTH_NAME=Microsoft
# GITPTIT_DB_WAIT_TIMEOUT=300
# GITPTIT_SSO_ATTEMPTS=3

# MinIO credentials (S3 API cổng 9000, console cổng 9001).
# Compose/Ansible map sang MINIO_ROOT_USER / MINIO_ROOT_PASSWORD của MinIO server.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minio_secret_password

# Gitea Domain
GITEA__server__DOMAIN=git.nits.io.vn
GITEA__server__ROOT_URL=https://git.nits.io.vn/
GITEA__server__SSH_DOMAIN=git.nits.io.vn

# Cloudflare tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Microsoft Entra ID (optional; leave all three empty to disable Microsoft SSO)
# Redirect URI đăng ký trên Entra ID: <GITEA__server__ROOT_URL>user/oauth2/<SSO_AUTH_NAME>/callback
SSO_CLIENT_ID=your_sso_client_id
SSO_SECRET=your_sso_client_secret_value
SSO_DIRECTORY_ID=your_sso_tenant_id

# GitHub Container Registry (Ansible tạo imagePullSecret ghcr-secret trong cluster)
GHCR_USERNAME=your_github_username
GHCR_TOKEN=your_github_pat_with_read_packages
GHCR_EMAIL=your_github_email

# API integration credentials
DOCLING_API_KEY=your_docling_api_key
EMBEDDING_API_KEY=your_embedding_api_key
NVIDIA_API_KEY=your_nvidia_nim_api_key
# LLM provider: openrouter (mặc định của web) hoặc nvidia. Model phải khớp provider.
LLM_PROVIDER=nvidia
OPENROUTER_API_KEY=
# Teacher AI web research (Tavily Search)
TAVILY_API_KEY=
# Milestone Defense (defense-worker). Frontend cần build lại với VITE_AI_DEFENSE_ENABLED.
AI_DEFENSE_ENABLED=false
# Backend gọi Gitea qua các biến này. Role gitea_bootstrap tự tạo token sau khi GitPTIT sẵn sàng.
GITEA_BASE_URL=http://gitptit:3000
GITEA_TOKEN=your_gitea_token
GITEA_ORG=
# URL công khai của Gitea (link clone/hiển thị cho người dùng)
GITEA_PUBLIC_URL=https://git.nits.io.vn

# Đăng nhập webapp bằng Microsoft (Entra ID) / Google — để trống nếu chưa dùng
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_ALLOWED_DOMAINS=stu.ptit.edu.vn,ptit.edu.vn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Assistant Config
WEBAPP_DB=assistant
DOMAIN=assistant.nits.io.vn
FRONTEND_HOST=https://assistant.nits.io.vn
ENVIRONMENT=staging
PROJECT_NAME="AI Assistant"
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://assistant.nits.io.vn"
SECRET_KEY=super_secret_key_please_change_this_to_random_string
FIRST_SUPERUSER=admin@nits.io.vn
FIRST_SUPERUSER_PASSWORD=admin1234
PUBLIC_SIGNUP_ENABLED=false
DEMO_SEED_ENABLED=false

# Email (chỉ cần khi bật gửi mail; backend coi là tắt nếu thiếu SMTP_HOST hoặc EMAILS_FROM_EMAIL)
SMTP_PASSWORD=
# SMTP_HOST=
# SMTP_USER=
# EMAILS_FROM_EMAIL=
